{
    "name": "company/cr-dashboard",
    "description": "Code Review Dashboard - GitLab review metrics on one page",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sqlite3": "*",
        "doctrine/dbal": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/cache": "~7.4.0",
        "symfony/config": "~7.4.0",
        "symfony/console": "~7.4.0",
        "symfony/dependency-injection": "~7.4.0",
        "symfony/doctrine-bridge": "~7.4.0",
        "symfony/dotenv": "~7.4.0",
        "symfony/error-handler": "~7.4.0",
        "symfony/event-dispatcher": "~7.4.0",
        "symfony/filesystem": "~7.4.0",
        "symfony/finder": "~7.4.0",
        "symfony/framework-bundle": "~7.4.0",
        "symfony/http-foundation": "~7.4.0",
        "symfony/http-kernel": "~7.4.0",
        "symfony/mercure": "^0.6",
        "symfony/monolog-bundle": "^4.0",
        "symfony/routing": "~7.4.0",
        "symfony/runtime": "~7.4.0",
        "symfony/stopwatch": "~7.4.0",
        "symfony/string": "~7.4.0",
        "symfony/var-dumper": "~7.4.0",
        "symfony/var-exporter": "~7.4.0",
        "symfony/yaml": "~7.4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.16",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs"
    }
}
